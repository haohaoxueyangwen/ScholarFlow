{
  "name": "@scholarflow/pi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pi-native runtime extension and skills for ScholarFlow.",
  "keywords": [
    "pi-package",
    "research-agent",
    "scholarflow"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts",
      "./providers/local-qwen/extension.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "test": "npm run test:eval-scoring && npm run test:contracts",
    "test:eval-scoring": "node ./scripts/run-with-pinned-node.mjs --test ./quality/*.test.mjs",
    "test:skill-spec": "node ./scripts/run-with-pinned-node.mjs ./scripts/validate-skills.mjs",
    "skill:review": "node ./scripts/run-with-pinned-node.mjs ./scripts/validate-skills.mjs --update-lock",
    "test:contracts": "node ./scripts/run-with-pinned-node.mjs ./scripts/evaluate-skills.mjs --timeout-ms=90000",
    "eval:skills": "node ./scripts/run-with-pinned-node.mjs ./scripts/evaluate-skills.mjs",
    "eval:skills:live": "node ./scripts/run-with-pinned-node.mjs ./scripts/evaluate-skills.mjs --live",
    "skill:new": "python ../../scripts/scaffold_skill.py --package-root ."
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.0 <0.85.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "typebox": "1.3.6"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
