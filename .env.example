# Pi model-backed evaluation. Keep real secrets in .env or Pi's user auth store.
SCHOLARFLOW_EVAL_PROVIDER=deepseek
SCHOLARFLOW_EVAL_MODEL=
DEEPSEEK_API_KEY=

# Optional executable overrides for machines with multiple runtimes.
SCHOLARFLOW_NODE=
SCHOLARFLOW_NPM=
SCHOLARFLOW_PYTHON=
SCHOLARFLOW_GLOBAL_PI_PREFIX=
SCHOLARFLOW_TECTONIC=

# Optional Zotero Web API integration.
ZOTERO_MODE=null
ZOTERO_USER_ID=
ZOTERO_API_KEY=
ZOTERO_SMOKE_ITEM_KEY=
ZOTERO_SMOKE_TAG=scholarflow-smoke

# Optional real experiment observation roots, separated with the host path separator.
SCHOLARFLOW_OBSERVE_ROOTS=

# AI knowledge engine. Keep disabled until the local LightRAG sidecar is ready.
SCHOLARFLOW_KNOWLEDGE_ENGINE=disabled
SCHOLARFLOW_LIGHTRAG_BASE_URL=http://127.0.0.1:9621
SCHOLARFLOW_LIGHTRAG_API_KEY=
SCHOLARFLOW_LIGHTRAG_WORKSPACE=scholarflow
SCHOLARFLOW_LIGHTRAG_TIMEOUT_SECONDS=15
SCHOLARFLOW_LIGHTRAG_ALLOW_REMOTE=false

# Scientific PDF parsing. Native pypdf remains the non-Docker fallback.
SCHOLARFLOW_PDF_PARSER=auto
SCHOLARFLOW_GROBID_BASE_URL=
SCHOLARFLOW_GROBID_TIMEOUT_SECONDS=120
SCHOLARFLOW_GROBID_ALLOW_REMOTE=false
SCHOLARFLOW_TESSERACT_EXE=
SCHOLARFLOW_OCR_LANGUAGES=eng
SCHOLARFLOW_OCR_DPI=200
SCHOLARFLOW_OCR_MAX_PAGES=200
SCHOLARFLOW_OCR_PAGE_TIMEOUT_SECONDS=60
